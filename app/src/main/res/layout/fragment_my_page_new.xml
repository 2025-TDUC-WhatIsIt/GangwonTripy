<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_profile_design"
    android:layout_width="match_parent"
    android:layout_height="800dp"
    android:background="@drawable/container_profile_design">

    <TextView
        android:id="@+id/text_profile1"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="72dp"
        android:layout_gravity="top|left"
        android:gravity="left|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:text="프로필"
        android:textColor="#FF000000"
        android:textSize="24dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/profile_card"
        android:layout_width="296dp"
        android:layout_height="220dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="118dp"
        android:layout_gravity="top|left"

        app:cardElevation="2dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/container_group4"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="31dp"
            android:layout_marginTop="46.13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/container_mask_group"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_gravity="top"
                android:scaleType="centerCrop"
                android:src="@drawable/container_mask_group" />

            <TextView
                android:id="@+id/username"
                android:layout_width="27.6dp"
                android:layout_height="19.71dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="97.26dp"
                android:layout_marginBottom="15.77dp"
                android:layout_gravity="left"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="재원"
                android:textColor="#FF000000"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="15.77dp"
                android:layout_marginLeft="29dp"
                android:layout_marginRight="28.83dp"
                android:layout_marginTop="116.97dp"
                android:layout_marginBottom="0dp"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="(칭호)"
                android:textColor="#FF000000"
                android:textSize="10dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_my_badges"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="205dp"
            android:layout_marginTop="163.5dp"
            android:layout_marginBottom="-0.5dp"
            android:layout_gravity="top|left"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="내가 모은 배지"
            android:textColor="#FF000000"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/text_received_titles"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="205dp"
            android:layout_marginTop="212.5dp"
            android:layout_marginBottom="-0.5dp"
            android:layout_gravity="top|left"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="내가 받은 칭호"
            android:textColor="#FF000000"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/text_visit_log"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="205dp"
            android:layout_marginTop="261.5dp"
            android:layout_marginBottom="-0.5dp"
            android:layout_gravity="top|left"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="나의 방문 일지"
            android:textColor="#FF000000"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/text_badge_count"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginLeft="205dp"
            android:layout_marginTop="184dp"
            android:layout_gravity="top|left"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="7개"
            android:textColor="#FF000000"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/text_badge_count1"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginLeft="205dp"
            android:layout_marginTop="233dp"
            android:layout_gravity="top|left"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="7개"
            android:textColor="#FF000000"
            android:textSize="10dp" />

        <TextView
            android:id="@+id/text_badge_count2"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginLeft="205dp"
            android:layout_marginTop="282dp"
            android:layout_gravity="top|left"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="7개"
            android:textColor="#FF000000"
            android:textSize="10dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:id="@+id/container_group5"
        android:layout_width="125dp"
        android:layout_height="265dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="377dp"
        android:layout_gravity="top|left"
        android:gravity="left|top"
        android:orientation="vertical">

        <TextView
            android:id="@+id/menu_favorites"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="1dp"

            android:layout_marginBottom="1dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableStart="@android:drawable/btn_star"
            android:drawablePadding="6dp"
            android:focusable="true"

            android:gravity="center_vertical"
            android:padding="6dp"
            android:text="@string/my_page_list_text1"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/container_group6"
            android:layout_width="82dp"
            android:layout_height="20dp"
            android:layout_gravity="left">

            <ImageView
                android:id="@+id/image_settings"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="left"
                android:scaleType="centerInside"
                android:src="@drawable/image_settings" />

            <TextView
                android:id="@+id/text_announcement"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginLeft="37dp"
                android:layout_marginTop="-0.5dp"
                android:layout_marginBottom="-0.5dp"
                android:layout_gravity="top"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="공지사항"
                android:textColor="#FF000000"
                android:textSize="12dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/container_group9"
            android:layout_width="110dp"
            android:layout_height="20dp"
            android:layout_marginTop="29dp"
            android:layout_gravity="left">

            <ImageView
                android:id="@+id/image_help_circle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="left"
                android:scaleType="centerInside"
                android:src="@drawable/image_help_circle" />

            <TextView
                android:id="@+id/text_faq"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginLeft="37dp"
                android:layout_marginTop="1.5dp"
                android:layout_marginBottom="-0.5dp"
                android:layout_gravity="top"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="자주 묻는 질문"
                android:textColor="#FF000000"
                android:textSize="12dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/container_group7"
            android:layout_width="99dp"
            android:layout_height="20dp"
            android:layout_marginTop="29dp"
            android:layout_gravity="left">

            <ImageView
                android:id="@+id/image_info"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="left"
                android:scaleType="centerInside"
                android:src="@drawable/image_info" />

            <TextView
                android:id="@+id/text_terms_policy"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginLeft="37dp"
                android:layout_marginTop="1.5dp"
                android:layout_marginBottom="-0.5dp"
                android:layout_gravity="top"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="약관 및 정책"
                android:textColor="#FF000000"
                android:textSize="12dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/container_group8"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="29dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/image_info1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="left"
                android:scaleType="centerInside"
                android:src="@drawable/image_info1" />

            <TextView
                android:id="@+id/text_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="1.5dp"
                android:layout_marginBottom="-0.5dp"
                android:layout_gravity="top"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="개인정보처리방침"
                android:textColor="#FF000000"
                android:textSize="12dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/container_group11"
            android:layout_width="81dp"
            android:layout_height="0dp"
            android:layout_marginTop="29dp"
            android:layout_gravity="left"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/image_log_out"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="left"
                android:scaleType="centerInside"
                android:src="@drawable/image_log_out" />

            <TextView
                android:id="@+id/text_logout"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="1.5dp"
                android:layout_marginBottom="-0.5dp"
                android:layout_gravity="top"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="로그아웃"
                android:textColor="#FF000000"
                android:textSize="12dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/container_group10"
            android:layout_width="81dp"
            android:layout_height="0dp"
            android:layout_marginTop="29dp"
            android:layout_gravity="left"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/image_user_minus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="left"
                android:scaleType="centerInside"
                android:src="@drawable/image_user_minus" />

            <TextView
                android:id="@+id/text_withdrawal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginLeft="36dp"
                android:layout_marginTop="1.5dp"
                android:layout_marginBottom="-0.5dp"
                android:layout_gravity="top"
                android:gravity="left|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="회원탈퇴"
                android:textColor="#FF000000"
                android:textSize="12dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
