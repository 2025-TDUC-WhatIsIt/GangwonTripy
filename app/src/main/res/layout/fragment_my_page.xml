<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".ui.mypage.MyPageFragment">

    <!-- 1. "프로필" 타이틀 -->
    <TextView
        android:id="@+id/text_title_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="프로필"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. 프로필 정보 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_profile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_title_profile">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 왼쪽: 프로필 사진과 이름 -->
            <ImageView
                android:id="@+id/image_profile"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:scaleType="centerCrop"
                android:src="@drawable/image_gone"
                android:layout_marginLeft="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="이름"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/image_profile"
                app:layout_constraintStart_toStartOf="@id/image_profile"
                app:layout_constraintTop_toBottomOf="@id/image_profile" />

            <TextView
                android:id="@+id/text_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(칭호)"
                android:textColor="#808080"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/text_name"
                app:layout_constraintStart_toStartOf="@id/text_name"
                app:layout_constraintTop_toBottomOf="@id/text_name" />

            <!-- 오른쪽: 배지, 칭호, 방문 일지 -->
            <TextView
                android:id="@+id/text_badge_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:text="내가 모은 배지"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/image_profile"
                app:layout_constraintTop_toTopOf="@id/image_profile" />

            <TextView
                android:id="@+id/text_badge_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7개"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/text_badge_title"
                app:layout_constraintTop_toBottomOf="@id/text_badge_title" />

            <TextView
                android:id="@+id/text_my_title_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="내가 받은 칭호"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/text_badge_title"
                app:layout_constraintTop_toBottomOf="@id/text_badge_count" />

            <TextView
                android:id="@+id/text_my_title_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7개"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/text_my_title_title"
                app:layout_constraintTop_toBottomOf="@id/text_my_title_title" />

            <TextView
                android:id="@+id/text_visit_log_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="나의 방문 일지"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/text_my_title_title"
                app:layout_constraintTop_toBottomOf="@id/text_my_title_count" />

            <TextView
                android:id="@+id/text_visit_log_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7개"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/text_visit_log_title"
                app:layout_constraintTop_toBottomOf="@id/text_visit_log_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. 메뉴 목록 -->
    <!-- Codia가 만든 복잡한 FrameLayout 대신, đơn giản한 LinearLayout과 TextView로 재구성합니다. -->
    <LinearLayout
        android:id="@+id/menu_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/card_profile"
        app:layout_constraintStart_toStartOf="@id/card_profile"
        app:layout_constraintTop_toBottomOf="@id/card_profile">

        <TextView
            android:id="@+id/menu_notice"
            style="@style/ProfileMenuItem"
            android:text="공지사항"
            app:drawableStartCompat="@drawable/ic_notice" />

        <TextView
            android:id="@+id/menu_faq"
            style="@style/ProfileMenuItem"
            android:text="자주 묻는 질문"
            app:drawableStartCompat="@drawable/ic_faq" />

        <TextView
            android:id="@+id/menu_terms"
            style="@style/ProfileMenuItem"
            android:text="약관 및 정책"
            app:drawableStartCompat="@drawable/ic_info" />

        <TextView
            android:id="@+id/menu_privacy"
            style="@style/ProfileMenuItem"
            android:text="개인정보처리방침"
            app:drawableStartCompat="@drawable/ic_info" />

        <TextView
            android:id="@+id/menu_logout"
            style="@style/ProfileMenuItem"
            android:text="로그아웃"
            app:drawableStartCompat="@drawable/ic_logout" />

        <TextView
            android:id="@+id/menu_withdraw"
            style="@style/ProfileMenuItem"
            android:text="회원탈퇴"
            app:drawableStartCompat="@drawable/ic_withdraw" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>