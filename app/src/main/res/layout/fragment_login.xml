<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:paddingTop="?attr/actionBarSize">

    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@mipmap/ic_launcher_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2" />

    <EditText
        android:id="@+id/login_id"
        android:hint="아이디"
        android:inputType="text"
        style="@style/CustomEditTextStyle"
        android:background="@drawable/img_rectangle"

        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/logo_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
         />

    <EditText
        android:id="@+id/login_pw"
        android:hint="비밀번호"
        android:inputType="textPassword"
        style="@style/CustomEditTextStyle"

        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/login_id"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/login_btn"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        android:text="로그인"
        android:textSize="14sp"
        android:textAlignment="center"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_pw"
        />

    <TextView
        android:id="@+id/login_or"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginTop="12dp"
        android:text="또는"
        android:textSize="12sp"
        android:textAlignment="center"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/login_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/login_kakao"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"

        android:src="@drawable/kakao_login_large_wide"
        android:scaleType="centerCrop"
        android:padding="0dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_or"
        />

    <TextView
        android:id="@+id/register"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginTop="0dp"
        android:text="회원가입"
        android:textSize="12sp"
        android:textAlignment="center"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/login_kakao"
        app:layout_constraintStart_toStartOf="@id/login_kakao" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="2dp"
        android:text="|"
        android:textSize="18sp"
        android:textAlignment="center"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/login_kakao"
        app:layout_constraintStart_toEndOf="@id/register" />

    <TextView
        android:id="@+id/find_account"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="10dp"
        android:text="계정 찾기"
        android:textSize="12sp"
        android:textAlignment="center"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/login_kakao"
        app:layout_constraintStart_toEndOf="@id/register" />

    <TextView
        android:id="@+id/inquiry"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="10dp"
        android:text="문의하기"
        android:textSize="12sp"
        android:textAlignment="center"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/login_kakao"
        app:layout_constraintEnd_toEndOf="@id/login_kakao" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="44dp"
        android:text="@string/splash_teamname_text"
        android:textColor="@color/dark_green"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />




</androidx.constraintlayout.widget.ConstraintLayout>