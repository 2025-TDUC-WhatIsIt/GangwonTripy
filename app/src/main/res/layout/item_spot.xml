<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- 1. 왼쪽 큰 대표 이미지 -->
    <ImageView
        android:id="@+id/iv_main_image"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:background="#FFEB3B"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

    <!-- 2. 오른쪽 작은 이미지 4개를 담을 GridLayout -->
    <GridLayout
        android:id="@+id/grid_layout_images"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="@id/iv_main_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/iv_main_image">

        <ImageView style="@style/SubImageViewStyle" tools:srcCompat="@tools:sample/avatars"/>
        <ImageView style="@style/SubImageViewStyle" tools:srcCompat="@tools:sample/avatars"/>
        <ImageView style="@style/SubImageViewStyle" tools:srcCompat="@tools:sample/avatars"/>
        <ImageView style="@style/SubImageViewStyle" tools:srcCompat="@tools:sample/avatars"/>

    </GridLayout>

    <!-- 3. 상호명 (예: 스타동 한성대점) -->
    <TextView
        android:id="@+id/tv_spot_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="스타동 한성대점"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_main_image"
        app:layout_constraintEnd_toStartOf="@id/iv_bookmark"/>

    <!-- 4. 주소 -->
    <TextView
        android:id="@+id/tv_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="서울 성북구 삼선교로 XX길 XX로"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_spot_name"
        app:layout_constraintEnd_toStartOf="@id/iv_bookmark"/>

    <!-- 5. 운영 시간 -->
    <TextView
        android:id="@+id/tv_operating_hours"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="08:00 ~ 21:00 (매주 일 휴무)"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_address"
        app:layout_constraintEnd_toStartOf="@id/iv_bookmark"/>

    <!-- 6. 북마크 아이콘 -->
    <ImageView
        android:id="@+id/iv_bookmark"
        android:layout_width="44dp"
        android:layout_height="54dp"
        android:src="@drawable/ic_bookmark_border"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_spot_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_operating_hours"/>

</androidx.constraintlayout.widget.ConstraintLayout>