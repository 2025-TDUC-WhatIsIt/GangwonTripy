<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.kakao.vectormap.MapView
        android:id="@+id/map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 상단 컨트롤 영역 (라운드 카드) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:translationZ="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- 지역 선택 드롭다운: 전체 / 인제 / 홍천 / 횡성 -->
            <!-- 지역 선택 드롭다운 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_location"
                style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="dropdown_menu">

                <!-- ⬅️ 반드시 MaterialAutoCompleteTextView 사용 -->
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/act_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="전체"
                    android:inputType="none"
                    android:importantForAutofill="no"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>


            <!-- contentType 필터칩 (타원형 버튼) -->
            <!-- contentType 필터칩 (타원형 버튼) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_types"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="false"
                    app:singleLine="true"
                    app:selectionRequired="false"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_12"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="관광지"
                        android:checkable="true"
                        android:checked="true"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_14"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="문화시설"
                        android:checkable="true"
                        android:checked="true"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_15"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="축제/공연"
                        android:checkable="true"
                        android:checked="true"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_39"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="음식점"
                        android:checkable="true"
                        android:checked="true"/>

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
