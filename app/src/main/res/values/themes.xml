<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GangwonTripy" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary brand color (light theme) -->
        <item name="colorPrimary">@color/dark_green</item> // 앱 맨 위 배경 색, 버튼 색
        <item name="colorPrimaryVariant">@color/white</item> // 앱 맨 위 글자 색
        <item name="colorOnPrimary">@color/white</item> // 버튼 글자 색
        <item name="android:fontFamily">@font/suit</item> // 기본 폰트
    </style>

    <style name="Theme.GangwonTripy" parent="Base.Theme.GangwonTripy" />

    <style name="BottomNavTextStyle" parent="TextAppearance.AppCompat.Caption">
        <!-- Figma 스펙에 맞게 텍스트 크기를 10sp로 지정 -->
        <item name="android:textSize">10sp</item>
    </style>

    <style name="ProfileMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="SubImageViewStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:background">#FFEB3B</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="CustomEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="maxLines">1</item>

        <item name="android:textColor">#808080</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

</resources>