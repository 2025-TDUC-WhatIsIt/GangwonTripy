        <item name="colorPrimary">@color/dark_green</item> // 앱 맨 위 배경 색, 버튼 색
        <item name="colorPrimaryVariant">@color/white</item> // 앱 맨 위 글자 색
        <item name="colorOnPrimary">@color/white</item> // 버튼 글자 색
