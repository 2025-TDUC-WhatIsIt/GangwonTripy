<?xml version="1.0" encoding="utf-8"?>
<!-- layer-list를 사용하여 여러 drawable을 겹칩니다. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 아래쪽 레이어: 흰색 배경 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>

    <!-- 2. 위쪽 레이어: 하단 테두리 선 -->
    <!-- top, left, right를 -2dp로 설정하여 해당 방향의 선을 화면 밖으로 밀어내고, -->
    <!-- bottom만 보이도록 하는 트릭입니다. -->
    <item
        android:top="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/bright_green" /> <!-- 연두색으로 변경 -->
        </shape>
    </item>
</layer-list>